<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base de la aplicación -->
    <style name="Base.Theme.UDBET" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/DarkBlue</item>
    </style>

    <!-- Tema principal -->
    <style name="Theme.UDBET" parent="Base.Theme.UDBET">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/Green</item>
    </style>

    <!-- Tema del Splash Screen -->
    <style name="Theme.UDBET.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/DarkBlue</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

</resources>